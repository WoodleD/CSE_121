build esp_err_codes/esp_common_err_codes.csv | ${cmake_ninja_workdir}esp_err_codes/esp_common_err_codes.csv: CUSTOM_COMMAND /home/lucas/esp/esp-idf/components/esp_common/include/esp_err.h /home/lucas/esp/esp-idf/components/esp_common/include/esp_err.h /home/lucas/esp/esp-idf/tools/err_codes_extract.py || esp-idf/cxx/libcxx.a esp-idf/esp_hal_gpio/libesp_hal_gpio.a esp-idf/esp_hal_pmu/libesp_hal_pmu.a esp-idf/esp_hw_support/libesp_hw_support.a esp-idf/esp_libc/libesp_libc.a esp-idf/esp_rom/libesp_rom.a esp-idf/esp_system/memory_ld_in_preprocess esp-idf/esp_system/sections_ld_in_preprocess esp-idf/freertos/libfreertos.a esp-idf/hal/libhal.a esp-idf/heap/libheap.a esp-idf/log/liblog.a esp-idf/pthread/libpthread.a esp-idf/soc/libsoc.a
  COMMAND = cd /home/lucas/esp/blink/build/esp-idf/esp_common && /home/lucas/.espressif/python_env/idf6.2_py3.12_env/bin/python /home/lucas/esp/esp-idf/tools/err_codes_extract.py --headers /home/lucas/esp/esp-idf/components/esp_common/include/esp_err.h --base-path /home/lucas/esp/esp-idf --output /home/lucas/esp/blink/build/esp_err_codes/esp_common_err_codes.csv
  DESC = Extracting error codes for esp_common
  restat = 1

